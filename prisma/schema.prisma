// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Transaction mode (port 6543) — dùng cho app
  directUrl = env("DIRECT_URL") // Direct connection (port 5432) — dùng cho prisma migrate
}

// ═══════════════════════════════════════════════════════
// 1. USERS — Quản lý người dùng & phân quyền
// ═══════════════════════════════════════════════════════
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  dob          DateTime?
  gender       Gender?
  role         Role      @default(GV)
  shortName    String?   @map("short_name") // Tên hiển thị trong TKB (Long)
  permissions  String[]  @default([]) // Tổ trưởng, GVBM, TPT Đội...
  branch       String    @default("Trường chính") // Trường chính / Phân hiệu
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  homeroomClasses Class[]      @relation("HomeroomTeacher")
  assignments     Assignment[]
  sessions        Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ═══════════════════════════════════════════════════════
// 2. SCHOOL_PLAN — Khung kế hoạch giáo dục (KHGD)
// ═══════════════════════════════════════════════════════
model SchoolPlan {
  id                String  @id @default(cuid())
  schoolYear        String  @map("school_year") // "2025-2026"
  grade             Int // 6, 7, 8, 9
  subjectName       String  @map("subject_name")
  // Tiết/tuần
  periodsPerWeekHk1 Float   @map("periods_per_week_hk1")
  periodsPerWeekHk2 Float   @map("periods_per_week_hk2")
  // Tổng tiết cả kỳ/năm
  totalHk1          Int     @map("total_hk1")
  totalHk2          Int     @map("total_hk2")
  totalYear         Int     @map("total_year")
  note              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([schoolYear, grade, subjectName])
  @@map("school_plans")
}

// ═══════════════════════════════════════════════════════
// 3. SUBJECTS — Môn học
// ═══════════════════════════════════════════════════════
model Subject {
  id              String   @id @default(cuid())
  name            String
  shortName       String?  @map("short_name") // Tên cấu hình hiển thị trong TKB
  grade           Int
  color           String   @default("#6366f1") // Màu hiển thị trên TKB
  parentSubjectId String?  @map("parent_subject_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Self-relation: môn tích hợp
  parentSubject Subject?  @relation("SubjectChildren", fields: [parentSubjectId], references: [id])
  childSubjects Subject[] @relation("SubjectChildren")

  // Relations
  curriculums Curriculum[]
  assignments Assignment[]

  @@unique([name, grade])
  @@map("subjects")
}

// ═══════════════════════════════════════════════════════
// 4. CLASSES — Lớp học
// ═══════════════════════════════════════════════════════
model Class {
  id                String   @id @default(cuid())
  name              String // "6A", "7B"...
  grade             Int
  schoolYear        String   @map("school_year")
  homeroomTeacherId String?  @map("homeroom_teacher_id")
  branch            String   @default("Trường chính")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  homeroomTeacher User?        @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  assignments     Assignment[]
  timetableCellNotes TimetableCellNote[]

  @@unique([name, schoolYear])
  @@map("classes")
}

// ═══════════════════════════════════════════════════════
// 5. CURRICULUM — Phân phối chương trình (PPCT)
// ═══════════════════════════════════════════════════════
model Curriculum {
  id           String   @id @default(cuid())
  subjectId    String   @map("subject_id")
  grade        Int // Áp dụng chung cho cả khối (VD: 6, 7, 8, 9)
  lessonNumber Int      @map("lesson_number") // Tiết PPCT (1,2,3...)
  lessonName   String   @map("lesson_name") // Tên bài dạy
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  subject           Subject            @relation(fields: [subjectId], references: [id])
  teachingSchedules TeachingSchedule[]

  @@unique([subjectId, grade, lessonNumber])
  @@map("curriculums")
}

// ═══════════════════════════════════════════════════════
// 6. ASSIGNMENTS — Phân công chuyên môn
// ═══════════════════════════════════════════════════════
model Assignment {
  id         String   @id @default(cuid())
  teacherId  String   @map("teacher_id")
  subjectId  String   @map("subject_id")
  classId    String   @map("class_id")
  roleNote   String?  @map("role_note") // "TTCM KHTN"...
  schoolYear String   @map("school_year")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  teacher        User            @relation(fields: [teacherId], references: [id])
  subject        Subject         @relation(fields: [subjectId], references: [id])
  class          Class           @relation(fields: [classId], references: [id])
  timetableSlots TimetableSlot[]

  @@unique([teacherId, subjectId, classId, schoolYear])
  @@map("assignments")
}

// ═══════════════════════════════════════════════════════
// 7. TIMETABLE_SLOTS — Thời khóa biểu
// ═══════════════════════════════════════════════════════
model TimetableSlot {
  id           String       @id @default(cuid())
  assignmentId String       @map("assignment_id")
  weekNumber   Int          @map("week_number")
  dayOfWeek    Int          @map("day_of_week")
  period       Int
  session      Session_Type
  status       SlotStatus   @default(NORMAL)
  schoolYear   String       @map("school_year")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  assignment        Assignment         @relation(fields: [assignmentId], references: [id])
  teachingSchedules TeachingSchedule[]

  @@index([weekNumber, dayOfWeek, period, session])
  @@map("timetable_slots")
}

// ═══════════════════════════════════════════════════════
// 8. TEACHING_SCHEDULES — Lịch Báo Giảng (LBG)
// ═══════════════════════════════════════════════════════
model TeachingSchedule {
  id               String         @id @default(cuid())
  timetableSlotId  String         @map("timetable_slot_id")
  curriculumId     String?        @map("curriculum_id")
  weekNumber       Int            @map("week_number")
  date             DateTime
  actualLessonNum  Int            @map("actual_lesson_num")
  actualLessonName String         @map("actual_lesson_name")
  status           ScheduleStatus @default(NORMAL)
  preparation      String?
  isPublished      Boolean        @default(false) @map("is_published")
  publishedAt      DateTime?      @map("published_at")
  note             String?
  // ─── Quản lý ép thủ công ───
  isManualOverride Boolean        @default(false) @map("is_manual_override") // true nếu GV ép số tiết khác TKB
  isProgression    Boolean        @default(false) @map("is_progression") // true nếu ép tịnh tiến, false nếu ép cục bộ
  autoLessonNum    Int?           @map("auto_lesson_num") // Số tiết đúng theo TKB (lưu để so sánh và hoàn tác)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  timetableSlot TimetableSlot       @relation(fields: [timetableSlotId], references: [id])
  curriculum    Curriculum?         @relation(fields: [curriculumId], references: [id])
  overrideLogs  LessonOverrideLog[]

  @@map("teaching_schedules")
}

// ═══════════════════════════════════════════════════════
// 9. LESSON_OVERRIDE_LOGS — Lịch sử ép số tiết thủ công
// ═══════════════════════════════════════════════════════
model LessonOverrideLog {
  id             String   @id @default(cuid())
  scheduleId     String   @map("schedule_id")
  weekNumber     Int      @map("week_number")
  className      String   @map("class_name") // Tên lớp (snapshot)
  subjectName    String   @map("subject_name") // Tên môn (snapshot)
  teacherName    String   @map("teacher_name") // Tên GV (snapshot)
  dayOfWeek      Int      @map("day_of_week") // Thứ mấy
  period         Int // Tiết mấy
  fromLessonNum  Int      @map("from_lesson_num") // Số tiết trước khi ép
  toLessonNum    Int      @map("to_lesson_num") // Số tiết sau khi ép
  fromLessonName String   @map("from_lesson_name") // Tên bài tương ứng số cũ
  toLessonName   String   @map("to_lesson_name") // Tên bài tương ứng số mới
  reason         String? // Lý do (tùy chọn)
  isProgression  Boolean  @default(false) @map("is_progression") // Loại ép tiết
  isReverted     Boolean  @default(false) @map("is_reverted") // Đã hoàn tác chưa?
  createdAt      DateTime @default(now()) @map("created_at")

  schedule TeachingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("lesson_override_logs")
}

// ═══════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════
enum Role {
  ADMIN
  BGH
  GV
}

enum Gender {
  NAM
  NU
}

enum Session_Type {
  SANG
  CHIEU
}

enum SlotStatus {
  NORMAL
  SUBSTITUTE
  CANCELLED
}

enum ScheduleStatus {
  NORMAL
  SUBSTITUTE
  MAKEUP
}

model WeeklySchoolPlan {
  id          String   @id @default(cuid())
  schoolYear  String   @map("school_year")
  grade       Int
  subjectName String   @map("subject_name")
  semester    Int
  weeklyData  Json     @map("weekly_data")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([schoolYear, grade, subjectName, semester])
  @@map("weekly_school_plans")
}

// ═══════════════════════════════════════════════════════
// 10. TIMETABLE_NOTES — Ghi chú cho Thời khóa biểu
// ═══════════════════════════════════════════════════════
model TimetableNote {
  id         String       @id @default(cuid())
  content    String
  schoolYear String       @map("school_year")
  branch     String       @default("Phân hiệu")
  weekNumber Int          @map("week_number")
  dayOfWeek  Int          @map("day_of_week")
  session    Session_Type

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([weekNumber, dayOfWeek, session, branch, schoolYear])
  @@map("timetable_notes")
}

// ═══════════════════════════════════════════════════════
// 11. SCHOOL_WEEKS — Cài đặt thời gian cho từng tuần học
// ═══════════════════════════════════════════════════════
model SchoolWeek {
  id         String   @id @default(cuid())
  schoolYear String   @map("school_year")
  weekNumber Int      @map("week_number")
  startDate  DateTime @map("start_date")
  endDate    DateTime @map("end_date")
  semester   Int      @default(1)
  isBreak    Boolean  @default(false) @map("is_break") // Nghỉ lễ/Tết
  note       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([schoolYear, weekNumber])
  @@map("school_weeks")
}

// ═══════════════════════════════════════════════════════
// 12. SYSTEM_CONFIG — Cài đặt hệ thống (Liên cấp, v.v...)
// ═══════════════════════════════════════════════════════
model SystemConfig {
  key   String @id
  value String // JSON string

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

// ═══════════════════════════════════════════════════════
// 13. TIMETABLE_CELL_NOTES — Ghi chú tùy chỉnh từng ô TKB
// ═══════════════════════════════════════════════════════
model TimetableCellNote {
  id         String       @id @default(cuid())
  classId    String       @map("class_id")
  weekNumber Int          @map("week_number")
  dayOfWeek  Int          @map("day_of_week")
  period     Int
  session    Session_Type
  schoolYear String       @map("school_year")
  content    String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  class Class @relation(fields: [classId], references: [id])

  @@unique([classId, weekNumber, dayOfWeek, period, session, schoolYear])
  @@map("timetable_cell_notes")
}
